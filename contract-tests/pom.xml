<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mighil31</groupId>
        <artifactId>kitchensink-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>contract-tests</artifactId>
    <name>kitchensink contract tests</name>
    <description>
        Black-box HTTP parity suite. Captures the legacy REST API's core behaviour and
        runs unchanged against the migrated app; only the base URL / credentials change.
    </description>

    <properties>
        <!-- Target under test. Override: mvn verify -Dcontract.baseUrl=http://localhost:8081/rest -->
        <contract.baseUrl>http://localhost:8080/kitchensink/rest</contract.baseUrl>
        <!-- Response format of the target: legacy | v2 -->
        <contract.format>legacy</contract.format>
        <!-- Optional HTTP Basic user (new app). Password comes from env CONTRACT_PASSWORD only. -->
        <contract.user></contract.user>
        <!-- Opt-in: the suite needs a running target, so a plain `mvn verify` (and CI) skips it.
             Run with: mvn verify -Pcontract -->
        <skipITs>true</skipITs>
    </properties>

    <profiles>
        <profile>
            <id>contract</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JSON serializer REST Assured uses for request bodies -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- *IT classes run in the integration-test phase (needs a running target);
                 plain `mvn test` never touches the network. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Use JUnit display names in the XML reports (e.g. "GET /members/abc -> 404"). -->
                    <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
                        <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
                    </statelessTestsetReporter>
                    <systemPropertyVariables>
                        <contract.baseUrl>${contract.baseUrl}</contract.baseUrl>
                        <contract.format>${contract.format}</contract.format>
                        <contract.user>${contract.user}</contract.user>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
