meta {
  name: Unknown member
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/members/000000000000000000000000
  body: none
  auth: inherit
}

assert {
  res.status: eq 404
}

tests {
  test("is a ProblemDetail", function() {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody()).to.include.keys("title", "status", "detail", "instance");
  });

  test("says the member wasn't found", function() {
    expect(res.getBody().detail).to.equal("Member not found");
  });
}

docs {
  A well-formed id that doesn't exist. Legacy: 404 with an empty body.
}
