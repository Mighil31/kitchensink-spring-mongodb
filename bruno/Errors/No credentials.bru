meta {
  name: No credentials
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/members
  body: none
  auth: none
}

assert {
  res.status: eq 401
}

tests {
  test("is a ProblemDetail", function() {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody()).to.include.keys("title", "status", "detail", "instance");
  });

  test("challenges for HTTP Basic", function() {
    expect(res.getHeader("www-authenticate")).to.equal('Basic realm="kitchensink"');
  });
}

docs {
  Every `/rest/**` endpoint needs HTTP Basic, reads too (ADR 0007). Legacy: 200, no auth at all.
  The `WWW-Authenticate` header is what makes a browser show its login box.
}
