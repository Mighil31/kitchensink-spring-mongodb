meta {
  name: Wrong password
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/members
  body: none
  auth: basic
}

auth:basic {
  username: {{apiUser}}
  password: not-the-password
}

assert {
  res.status: eq 401
}

tests {
  test("is a ProblemDetail", function() {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody()).to.include.keys("title", "status", "detail", "instance");
  });

  test("doesn't say which part was wrong", function() {
    expect(res.getBody().detail).to.equal("Authentication required");
  });
}

docs {
  Same 401 and the same generic detail as no credentials at all: the response never says whether
  the user or the password was wrong.
}
