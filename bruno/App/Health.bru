meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{appUrl}}/actuator/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("is UP", function() {
    expect(res.getBody().status).to.equal("UP");
  });
}

docs {
  Actuator health, public (no credentials). Only `health` and `info` are exposed.
  Not on legacy.
}
