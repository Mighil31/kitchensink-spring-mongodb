{
  "items": [
    {
      "id": "ADR-0002",
      "change": "Member id format",
      "legacy": "Sequential number (0, 1, 2…)",
      "new": "24-hex MongoDB ObjectId",
      "source": "ADR 0002",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.getReturnsMemberWithHexIdAndNoLegacyId"
    },
    {
      "id": "A1",
      "change": "Successful create response",
      "legacy": "200, empty body, no Location",
      "new": "201 + Location header + member body",
      "source": "Gap Analysis A1",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.createReturns201WithLocationAndMember"
    },
    {
      "id": "ADR-0003",
      "change": "Error response body",
      "legacy": "Different ad-hoc shape per error; empty 404",
      "new": "RFC 9457 ProblemDetail with an errors map",
      "source": "ADR 0003",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.invalidBodyIs400ProblemWithFieldErrors"
    },
    {
      "id": "ADR-0007",
      "change": "API authentication",
      "legacy": "None",
      "new": "HTTP Basic on all of /rest/**; 401 ProblemDetail without credentials",
      "source": "ADR 0007",
      "status": "decided",
      "verifiedBy": "SecurityConfigTest.Api.withoutCredentialsIs401ProblemDetailWithChallenge"
    },
    {
      "id": "B1",
      "change": "Concurrent registrations with the same email",
      "legacy": "One 200; losers get 409 or 400 with transaction-manager text",
      "new": "One 201; every other request 409",
      "source": "Gap Analysis B1 · ADR 0005",
      "status": "decided",
      "verifiedBy": "MemberRegistrationIT.concurrentRegistrationsWithSameEmailStoreExactlyOne"
    },
    {
      "id": "B2",
      "change": "Email uniqueness ignores case",
      "legacy": "JOHN@x.com accepted next to john@x.com",
      "new": "Emails stored lower-case; JOHN@x.com gets 409 Conflict",
      "source": "Gap Analysis B2 · ADR 0011",
      "status": "decided",
      "verifiedBy": "MemberRegistrationIT.emailIsStoredLowerCaseSoUniquenessIgnoresCase"
    },
    {
      "id": "B3",
      "change": "Blank name",
      "legacy": "\"   \" accepted (200)",
      "new": "400 validation error",
      "source": "Gap Analysis B3",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.nameOfOnlyWhitespaceIs400"
    },
    {
      "id": "B5, B17",
      "change": "Malformed JSON or JSON array body",
      "legacy": "500 with RESTEasy / JSON-B internals",
      "new": "400 ProblemDetail, no internals",
      "source": "Gap Analysis B5, B17 · ADR 0003",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.unreadableBodyIs400ProblemWithoutInternals"
    },
    {
      "id": "B6",
      "change": "Null request body",
      "legacy": "400 with Hibernate Validator code HV000116",
      "new": "400 ProblemDetail, no internals",
      "source": "Gap Analysis B6 · ADR 0003",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.missingBodyIs400ProblemWithoutValidatorCodes"
    },
    {
      "id": "B14",
      "change": "Refresh after registering in the UI",
      "legacy": "Browser re-POSTs the form",
      "new": "Post/Redirect/Get: refresh reloads the page, no second registration",
      "source": "Gap Analysis B14 · ADR 0004",
      "status": "decided",
      "verifiedBy": "MemberControllerTest.validRegistrationRedirectsWithFlashMessage"
    },
    {
      "id": "B7",
      "change": "Duplicate email in the UI",
      "legacy": "Shows the database's raw exception text",
      "new": "\"Email taken\" next to the email field",
      "source": "Gap Analysis B7 · ADR 0004",
      "status": "decided",
      "verifiedBy": "MemberControllerTest.takenEmailIsAFieldErrorNotExceptionText"
    },
    {
      "id": "B4",
      "change": "Client-supplied id in the request body",
      "legacy": "400 with Hibernate 'detached entity' message",
      "new": "No id field in the request; a sent id is ignored and the database generates one",
      "source": "Gap Analysis B4 · ADR 0013",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.clientCannotChooseTheId"
    },
    {
      "id": "B10",
      "change": "Unknown JSON fields",
      "legacy": "Silently ignored (200)",
      "new": "Still ignored, as legacy (tolerant reader)",
      "source": "Gap Analysis B10 · ADR 0013",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.unknownFieldsAreIgnored"
    },
    {
      "id": "B11",
      "change": "Name rule vs its message",
      "legacy": "Only digits rejected; message says 'letters and spaces'",
      "new": "Letters of any script, spaces and . ' - only; the message says so",
      "source": "Gap Analysis B11 · ADR 0013",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.nameWithOtherCharactersIs400"
    },
    {
      "id": "B12",
      "change": "Emails without a top-level domain",
      "legacy": "a@b and jane@gmail accepted (200)",
      "new": "400: the domain needs a dot and a final label of 2+ characters",
      "source": "Gap Analysis B12 · ADR 0014",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.emailWithoutTopLevelDomainIs400"
    },
    {
      "id": "B19",
      "change": "Other scripts' digits and symbols in names",
      "legacy": "Ana١, Ana１, emoji and <b>bold</b> accepted (200)",
      "new": "400 with the name message",
      "source": "Gap Analysis B19 · ADR 0013",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.nameWithOtherCharactersIs400"
    },
    {
      "id": "B18",
      "change": "Phone numbers that only parse as numbers",
      "legacy": "+123456789, 1.23456789E9 and Arabic-Indic digits accepted (200)",
      "new": "400: phone numbers are 10 to 12 digits 0-9",
      "source": "Gap Analysis B18 · ADR 0013",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.phoneThatOnlyParsesAsANumberIs400"
    },
    {
      "id": "B16",
      "change": "Field breaking two rules",
      "legacy": "One message, chosen at random",
      "new": "One message per field, picked in a fixed order (missing, then length, then content)",
      "source": "Gap Analysis B16 · ADR 0013",
      "status": "decided",
      "verifiedBy": "MemberRestControllerTest.fieldBreakingSeveralRulesAlwaysGetsTheSameMessage"
    },
    {
      "id": "A3",
      "change": "Member list pagination",
      "legacy": "Whole list, unbounded",
      "new": "Optional ?page=&size= (max 100), same array, Link rel=next; no parameters = whole list",
      "source": "Gap Analysis A3 · ADR 0013",
      "status": "decided",
      "verifiedBy": "MemberListPagingTest.aPageWithMoreAfterItLinksToTheNextOne"
    }
  ]
}
